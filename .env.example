DATABASE_URL=postgres://tunelynk:tunelynk@localhost:5432/tunelynk
PORT=3000

# Public origin used in sign-in links and the Apple redirect URI (no trailing slash).
# Local dev: the Vite server, which proxies /api.
APP_URL=http://localhost:5173

# Apple Music developer token (MusicKit key). APPLE_PRIVATE_KEY = base64 of the .p8 file.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_STOREFRONT=us
APPLE_CATALOG_RPS=8
APPLE_CATALOG_BURST=10
APPLE_CATALOG_CONCURRENCY=4

# LLM (engine). LLM_PROVIDER = anthropic | openai; the matching key is required.
LLM_PROVIDER=anthropic
LLM_MODEL_GUEST=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MAX_TOKENS=2000
LLM_DAILY_BUDGET_USD=2

# Guest cookie signing (32+ chars): openssl rand -base64 48
SESSION_SECRET=
# false for local http; production default is true
COOKIE_SECURE=false

# Magic-link email. console logs links (dev); resend sends them.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Tunelynk <login@bytmoor.com>
