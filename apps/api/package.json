{
  "name": "@tunelynk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tunelynk/db": "workspace:*",
    "@tunelynk/shared": "workspace:*",
    "hono": "^4.13.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tunelynk/config": "workspace:*",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
